APP_NAME=Pelevo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production (Forge): APP_URL=https://pelevo.com
PELEVO_IOS_STORE_URL=
PELEVO_ANDROID_STORE_URL=

ADMIN_EMAIL=admin@pelevo.test
ADMIN_PASSWORD=Admin-password-9!

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local WAMP / Forge production default is MySQL.
# For Postgres (including Supabase DB), set DB_CONNECTION=pgsql and SSL as needed.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pelevo
DB_USERNAME=root
DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Local: public/local disks. Production/Forge: prefer s3 (see deploy/forge/env.production.example).
# Legacy Supabase storage disk remains available via FILESYSTEM_DISK=supabase.
FILESYSTEM_DISK=local
MEDIA_UPLOAD_DISK=local
ADMIN_EXPORT_DISK=local
DATA_EXPORT_DISK=local
MEDIA_MAX_REEL_BYTES=209715200
MEDIA_MAX_REEL_DURATION_MS=60000
MEDIA_UPLOAD_URL_TTL_MINUTES=15
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
REEL_QUALIFIED_VIEW_MS=3000
REEL_VIEW_WINDOW_MINUTES=60
REEL_QUALIFIED_VIEWS_PER_WINDOW=1
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=1200
HORIZON_PATH=admin/horizon
HORIZON_PREFIX=pelevo_horizon:
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180
OPERATIONS_READINESS_TOKEN=
CATALOG_RSS_POLL_BATCH_SIZE=500
CATALOG_RSS_QUEUE_MAX_DEPTH=5000
CATALOG_FEED_STATE_BACKFILL_BATCH_SIZE=1000
CATALOG_SYNC_RUN_RETENTION_DAYS=90

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional: keep using Supabase only as S3-compatible object storage
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_URL=

VITE_APP_NAME="${APP_NAME}"

# Firebase Admin service-account JSON path for FCM HTTP v1 (server). Not google-services.json.
FCM_CREDENTIALS=
# Legacy FCM server key is unused when credentials are set.
FCM_SERVER_KEY=

PODCAST_INDEX_ENABLED=false
PODCAST_INDEX_BASE_URL=https://api.podcastindex.org/api/1.0
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
PODCAST_INDEX_USER_AGENT=Pelevo/1.3
PODCAST_INDEX_TIMEOUT=5

AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=
AI_PROVIDER=
AI_MODEL=

MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=

PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYPAL_ACCESS_TOKEN=
PAYPAL_PAYOUT_URL=
PAYPAL_PAYOUT_VERIFICATION_URL=
APPLE_WEBHOOK_SECRET=
GOOGLE_WEBHOOK_SECRET=
GOOGLE_IDENTITY_URL=https://openidconnect.googleapis.com/v1/userinfo
APPLE_IDENTITY_URL=
APPLE_BUNDLE_ID=com.Podemeraldltd.pelevo
GOOGLE_PACKAGE_NAME=com.Podemeraldltd.pelevo
EARN_INTEGRITY_URL=
EARN_INTEGRITY_TOKEN=
EARN_INTEGRITY_ALLOW_JWT_PASSTHROUGH=false
