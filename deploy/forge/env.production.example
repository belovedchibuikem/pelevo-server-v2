# Pelevo API — Laravel Forge production environment template
# Copy values into Forge → Site → Environment. Do not commit real secrets.
#
# Recommended Forge stack (Pelevo production):
# - App server: Ubuntu + PHP 8.3 + Nginx + Redis + PostgreSQL
# - Object storage: AWS S3 / DigitalOcean Spaces / Cloudflare R2 via the `s3` disk
# - Daemon: `php artisan horizon`
# - Scheduler: Forge "Schedule" → `php artisan schedule:run`

APP_NAME=Pelevo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pelevo.com

# Optional store listing links for admin/support surfaces
PELEVO_IOS_STORE_URL=
PELEVO_ANDROID_STORE_URL=

ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (Forge PostgreSQL on the app server) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pelevo
DB_USERNAME=forge
DB_PASSWORD=
DB_SSLMODE=prefer

# --- Sessions / cache / queues ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.pelevo.com
SANCTUM_STATEFUL_DOMAINS=pelevo.com,www.pelevo.com

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=1200

HORIZON_PATH=admin/horizon
HORIZON_PREFIX=pelevo_horizon:

BROADCAST_CONNECTION=log

# --- Storage (NOT Supabase) ---
# Prefer S3-compatible object storage for reels/media/exports.
FILESYSTEM_DISK=s3
MEDIA_UPLOAD_DISK=s3
ADMIN_EXPORT_DISK=s3
DATA_EXPORT_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=pelevo-media
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Small/local bootstrap only (episode drafts on disk). Prefer s3 above for production media.
# FILESYSTEM_DISK=public
# MEDIA_UPLOAD_DISK=local

MEDIA_MAX_REEL_BYTES=209715200
MEDIA_MAX_REEL_DURATION_MS=60000
MEDIA_UPLOAD_URL_TTL_MINUTES=15
FFPROBE_BINARY=/usr/bin/ffprobe
FFMPEG_BINARY=/usr/bin/ffmpeg

REEL_QUALIFIED_VIEW_MS=3000
REEL_VIEW_WINDOW_MINUTES=60
REEL_QUALIFIED_VIEWS_PER_WINDOW=1

SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180
OPERATIONS_READINESS_TOKEN=
CATALOG_RSS_POLL_BATCH_SIZE=500
CATALOG_RSS_QUEUE_MAX_DEPTH=5000
CATALOG_FEED_STATE_BACKFILL_BATCH_SIZE=1000
CATALOG_SYNC_RUN_RETENTION_DAYS=90

# --- Mail (Forge usually uses SMTP / Postmark / SES / Resend) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@pelevo.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Integrations ---
FCM_CREDENTIALS=/home/forge/pelevo.com/storage/app/firebase/service-account.json
FCM_SERVER_KEY=

PODCAST_INDEX_ENABLED=true
PODCAST_INDEX_BASE_URL=https://api.podcastindex.org/api/1.0
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
PODCAST_INDEX_USER_AGENT="Pelevo/1.3 +https://pelevo.com"
PODCAST_INDEX_TIMEOUT=5

PELEVO_CRAWLER_USER_AGENT="Pelevo/1.0.0 (podcast-sync; +https://pelevo.com)"

GOOGLE_IDENTITY_URL=https://openidconnect.googleapis.com/v1/userinfo
APPLE_IDENTITY_URL=
APPLE_BUNDLE_ID=com.Podemeraldltd.pelevo
GOOGLE_PACKAGE_NAME=com.Podemeraldltd.pelevo
EARN_INTEGRITY_URL=
EARN_INTEGRITY_TOKEN=
EARN_INTEGRITY_ALLOW_JWT_PASSTHROUGH=false

PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYPAL_ACCESS_TOKEN=
PAYPAL_PAYOUT_URL=
PAYPAL_PAYOUT_VERIFICATION_URL=
APPLE_WEBHOOK_SECRET=
GOOGLE_WEBHOOK_SECRET=

MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=

AI_PROVIDER_URL=
AI_PROVIDER_TOKEN=
AI_PROVIDER=
AI_MODEL=

VITE_APP_NAME="${APP_NAME}"
